<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- INTERNET is already declared in src/main/AndroidManifest.xml.
         MainActivity carries MAIN/LAUNCHER so Flutter/adb always resolve a
         stable launch component (see comment in main manifest). Debug may
         show an extra launcher entry alongside the enabled activity-alias. -->
    <uses-permission android:name="android.permission.INTERNET"/>
</manifest>
