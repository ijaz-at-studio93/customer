<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- INTERNET is already declared in src/main/AndroidManifest.xml.
         This file intentionally does NOT add a second MAIN/LAUNCHER on
         MainActivity — that caused two "Scuts" icons in debug (MainActivity
         used ic_launcher while the alias used customer_*).
         `flutter run` starts MainActivity by explicit component; launcher
         icons come only from the enabled activity-alias. -->
    <uses-permission android:name="android.permission.INTERNET"/>
</manifest>
